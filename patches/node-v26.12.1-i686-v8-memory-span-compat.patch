--- a/deps/v8/src/inspector/string-util.h
+++ b/deps/v8/src/inspector/string-util.h
@@ -54,4 +54,16 @@
   static Binary fromBase64(const String& base64, bool* success);
+#if defined(__i386__) && defined(__linux__)
+  static Binary fromBytes(const uint8_t* data, size_t size) {
+    auto bytes = std::make_shared<std::vector<uint8_t>>();
+    if (size != 0) bytes->assign(data, data + size);
+    return Binary(bytes);
+  }
+#endif
+
   static Binary fromSpan(v8_crdtp::span<uint8_t> span) {
+#if defined(__i386__) && defined(__linux__)
+    return fromBytes(span.data(), span.size());
+#else
     return fromSpan(v8::MemorySpan<const uint8_t>(span.begin(), span.size()));
+#endif
   }
