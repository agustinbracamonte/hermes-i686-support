diff --git a/tests/pm/test_chromium.py b/tests/pm/test_chromium.py
index c4a05d3a32..3ac2a5957b 100644
--- a/tests/pm/test_chromium.py
+++ b/tests/pm/test_chromium.py
@@ -57,3 +57,20 @@ def test_locked_chromium_is_patched_chrome_for_testing():
         url = lock.artifacts(package.name, target)[0]["url"]
         assert url == package.fetch_url(version, target)
         assert "/builds/cft/" in url
+
+
+def test_i686_chromium_gap_does_not_change_x64_or_arm64_defaults():
+    from pm.defaults import default_packages
+
+    lock = Lockfile(lockfile_path())
+    names = lock.names()
+    package = Chromium()
+    assert package.missing_reason("linux-i686") == \
+        "Chrome for Testing does not publish Linux i686 builds"
+    assert "chromium" not in default_packages(
+        names, target="linux-i686", declined_names=frozenset())
+    for target in ("linux-x64", "linux-arm64"):
+        assert package.missing_reason(target) is None
+        assert lock.artifacts("chromium", target)
+        assert "chromium" in default_packages(
+            names, target=target, declined_names=frozenset())
