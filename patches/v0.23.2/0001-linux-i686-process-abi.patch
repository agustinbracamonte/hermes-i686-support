+def _linux_entry_elf_reason(entry: Path, target: str) -> str:
+    """Reject a mixed-width ELF payload in an i686 Linux tool entry."""
+    if target not in ("linux-i686", "linux-i686-musl"):
+        return ""
+    for path in entry.rglob("*"):
+        if not path.is_file():
+            continue
+        try:
+            with path.open("rb") as handle:
+                is_elf = handle.read(4) == b"\x7fELF"
+        except OSError as exc:
+            return f"cannot inspect {path.name} in the {target} entry: {exc}"
+        if is_elf and machine_matches_binary(path, target) is not True:
+            return f"{path.name} is not an ELF32/EM_386 object for {target}"
+    return ""
+
