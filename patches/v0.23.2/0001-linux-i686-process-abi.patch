+    _machine="$(od -An -tx2 -j18 -N2 "$_exe" 2>/dev/null | tr -d '[:space:]')"
+    [ "$_magic" = 7f454c46 ] || return 1
+    linux_abi_target_from_elf "$_kernel" "$_bits" "$_class" "$_data" "$_machine"
+}
