+# --- BEGIN: Linux process ABI probe ---
+# uname describes the kernel. The ELF interpreter launched by this shell
+# describes the userland that the bootstrapped uv must run in.
+linux_abi_target_from_elf() {
+    local _kernel="$1" _bits="$2" _class="$3" _data="$4" _machine="$5"
+    [ "$_data" = 1 ] || return 1 # Supported Linux targets are little-endian.
+    case "$_kernel" in
+        x86_64|amd64|x64)
+            case "$_bits:$_class:$_machine" in
+                32:1:0003) echo i686 ;;
+                64:2:003e) echo x64 ;;
+                *) return 1 ;;
+            esac
+            ;;
+        i386|i486|i586|i686|x86)
+            [ "$_bits:$_class:$_machine" = "32:1:0003" ] && echo i686 || return 1
+            ;;
+        aarch64|arm64)
+            [ "$_bits:$_class:$_machine" = "64:2:00b7" ] && echo arm64 || return 1
+            ;;
+        *) return 1 ;;
+    esac
+}
+
+linux_process_arch_from_elf() {
+    local _exe="$1" _kernel="$2" _bits="$3" _magic _class _data _machine
