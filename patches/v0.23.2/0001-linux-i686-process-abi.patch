+def _linux_process_arch(machine: str, pointer_bytes: int, elf_identity: tuple[int, int]) -> str:
+    """Resolve x86 Linux userspace from its Python process ABI, not the kernel.
+
+    ``platform.machine()`` is uname-derived on Linux: a 32-bit Python on an
+    x86_64 kernel still reports x86_64. The interpreter ELF class and machine
+    distinguish i686 from x86_64 and reject x32 or mixed-width runtimes.
+    """
+    machine = machine.strip().lower()
+    if machine in ("x86_64", "amd64", "x64", "i386", "i486", "i586", "i686", "x86"):
+        expected = {
+            (4, (1, 3)): "i686",       # ELFCLASS32 / EM_386
+            (8, (2, 62)): "x86_64",   # ELFCLASS64 / EM_X86_64
+        }.get((pointer_bytes, elf_identity))
+        kernel_is_x86 = machine in ("x86_64", "amd64", "x64")
+        process_is_x86 = machine in ("i386", "i486", "i586", "i686", "x86")
+        if expected == "i686" and (kernel_is_x86 or process_is_x86):
+            return expected
+        if expected == "x86_64" and kernel_is_x86:
+            return expected
+        raise RuntimeError(
+            f"unsupported or inconsistent Linux x86 process ABI: kernel={machine}, "
+            f"pointer_bytes={pointer_bytes}, ELF={elf_identity}"
+        )
+    if machine in ("aarch64", "arm64"):
+        if pointer_bytes == 8 and elf_identity == (2, 183):  # ELFCLASS64 / EM_AARCH64
+            return "aarch64"
+        raise RuntimeError(
+            f"unsupported or inconsistent Linux ARM process ABI: kernel={machine}, "
+            f"pointer_bytes={pointer_bytes}, ELF={elf_identity}"
+        )
+    return machine
+
+
+def _linux_interpreter_elf_identity() -> tuple[int, int]:
+    """Read the running Python interpreter's ELF class and e_machine."""
+    try:
+        with open(os.path.realpath(sys.executable), "rb") as handle:
+            header = handle.read(20)
+    except OSError as exc:
+        raise RuntimeError(f"cannot inspect the running Python ELF ABI: {exc}") from exc
+    if len(header) < 20 or header[:4] != b"\x7fELF" or header[5] not in (1, 2):
+        raise RuntimeError("cannot safely determine Linux process ABI: Python is not a supported ELF executable")
+    byteorder = "little" if header[5] == 1 else "big"
+    return header[4], int.from_bytes(header[18:20], byteorder)
 
 
 def _native_machine() -> str:
     """Native host arch; PM also runs alone before the app is importable."""
+    if sys.platform == "linux":
+        return _linux_process_arch(platform.machine(), struct.calcsize("P"), _linux_interpreter_elf_identity())
