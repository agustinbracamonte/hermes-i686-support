diff --git a/tests/pm/test_pnpm_wasm.py b/tests/pm/test_pnpm_wasm.py
new file mode 100644
index 0000000000..89a3f009c6
--- /dev/null
+++ b/tests/pm/test_pnpm_wasm.py
@@ -0,0 +1,93 @@
+"""The Linux i686 pnpm 12.15.0 entry is the official WASM package, not a native shim."""
+
+from __future__ import annotations
+
+import io
+import json
+import tarfile
+from pathlib import Path
+
+import pm.packages
+from pm.package import verify_package_entry
+from pm.registry import get_package
+
+
+WASM_URL = "https://registry.npmjs.org/@pnpm/wasm/-/wasm-12.15.0.tgz"
+WASM_SHA256 = "172c9d9a2b8b82b00a67323ffa6d34c32f8706279661329ea460432b95c9da1f"
+
+
+def _wasm_archive(path: Path, *, version: str = "12.15.0", magic: bytes = b"\x00asm") -> Path:
+    manifest = {
+        "name": "@pnpm/wasm",
+        "version": version,
+        "engines": {"node": ">=22.13"},
+        "bin": {"pnpm": "dist/pnpm.mjs"},
+    }
+    entries = {
+        "package/package.json": json.dumps(manifest).encode(),
+        "package/dist/pnpm.wasm": magic + b"\x01\x00\x00\x00",
+        "package/dist/pnpm.mjs": b"// fixture only\n",
+        "package/dist/pnpx.mjs": b"// fixture only\n",
+    }
+    with tarfile.open(path, "w:gz") as archive:
+        for name, content in entries.items():
+            member = tarfile.TarInfo(name)
+            member.size = len(content)
+            member.mode = 0o644
+            archive.addfile(member, io.BytesIO(content))
+    return path
+
+
+def test_pnpm_i686_pin_and_other_platform_urls_are_unchanged():
+    package = get_package("pnpm")
+    assert package.fetch_urls("12.15.0", "linux-i686") == [WASM_URL]
+    assert package.fetch_urls("12.15.0", "linux-x64") == [
+        "https://registry.npmjs.org/@pnpm/exe.linux-x64/-/exe.linux-x64-12.15.0.tgz",
+        "https://registry.npmjs.org/pnpm/-/pnpm-12.15.0.tgz",
+    ]
+    assert package.fetch_urls("12.15.0", "linux-arm64") == [
+        "https://registry.npmjs.org/@pnpm/exe.linux-arm64/-/exe.linux-arm64-12.15.0.tgz",
+        "https://registry.npmjs.org/pnpm/-/pnpm-12.15.0.tgz",
+    ]
+
+    lock = json.loads(Path(pm.packages.__file__).parents[1].joinpath("pm/lock.json").read_text())
+    artifact = lock["packages"]["pnpm"]["artifacts"]["linux-i686"]
+    assert artifact == [{"url": WASM_URL, "sha256": WASM_SHA256}]
+    assert lock["packages"]["pnpm"]["artifacts"]["linux-x64"] == [
+        {"sha256": "402f7045b1e0587acb1542f18d38afbccb6babf3c7451394e6fb3d9f0160c6ca", "url": "https://registry.npmjs.org/@pnpm/exe.linux-x64/-/exe.linux-x64-12.15.0.tgz"},
+        {"sha256": "f5173f6127cc505cdb36ec17719fe54a8511c6fd8560c7ceb4bf7c73e3b4458b", "url": "https://registry.npmjs.org/pnpm/-/pnpm-12.15.0.tgz"},
+    ]
+    assert lock["packages"]["pnpm"]["artifacts"]["linux-arm64"] == [
+        {"sha256": "8117d65f28e627e949d5fc65d63342266326826a56fa374317bf13fe1166a50e", "url": "https://registry.npmjs.org/@pnpm/exe.linux-arm64/-/exe.linux-arm64-12.15.0.tgz"},
+        {"sha256": "f5173f6127cc505cdb36ec17719fe54a8511c6fd8560c7ceb4bf7c73e3b4458b", "url": "https://registry.npmjs.org/pnpm/-/pnpm-12.15.0.tgz"},
+    ]
+
+
+def test_pnpm_wasm_unpack_wires_cli_and_verifies_cross_target(tmp_path, monkeypatch):
+    package = get_package("pnpm")
+    archive = _wasm_archive(tmp_path / "wasm-12.15.0.tgz")
+    entry = tmp_path / "pnpm-12.15.0-linux-i686"
+    package.unpack(archive, entry, "linux-i686")
+    monkeypatch.setattr(pm.packages, "current_target", lambda: "linux-x64")
+
+    assert verify_package_entry(package, entry, "linux-i686") == ""
+    assert package.binary(entry, "linux-i686") == entry / "bin" / "pnpm"
+    for name in ("pnpm", "pn", "pnpx", "pnx"):
+        wrapper = entry / "bin" / name
+        assert wrapper.is_file()
+        assert wrapper.stat().st_mode & 0o111
+        assert "exec node" in wrapper.read_text()
+    assert (entry / "package" / "dist" / "pnpm.wasm").read_bytes().startswith(b"\x00asm")
+
+
+def test_pnpm_wasm_rejects_wrong_version_and_bad_module(tmp_path, monkeypatch):
+    package = get_package("pnpm")
+    monkeypatch.setattr(pm.packages, "current_target", lambda: "linux-x64")
+
+    wrong_version = tmp_path / "wrong-version"
+    package.unpack(_wasm_archive(tmp_path / "wrong-version.tgz", version="12.14.0"), wrong_version, "linux-i686")
+    assert "name/version" in package.verify(wrong_version, "linux-i686")
+
+    bad_module = tmp_path / "bad-module"
+    package.unpack(_wasm_archive(tmp_path / "bad-module.tgz", magic=b"ELF!"), bad_module, "linux-i686")
+    assert "invalid WebAssembly header" in package.verify(bad_module, "linux-i686")
