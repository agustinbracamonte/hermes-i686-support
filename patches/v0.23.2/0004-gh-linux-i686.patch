diff --git a/tests/pm/test_gh_i686.py b/tests/pm/test_gh_i686.py
new file mode 100644
index 0000000000..2d997c668b
--- /dev/null
+++ b/tests/pm/test_gh_i686.py
@@ -0,0 +1,28 @@
+"""The pinned GitHub CLI 386 release is selected only for Linux i686."""
+
+from pm import paths
+from pm.lock import Lockfile
+from pm.registry import get_package
+
+
+URL = "https://github.com/cli/cli/releases/download/v2.97.0/gh_2.97.0_linux_386.tar.gz"
+SHA256 = "ba556b1061cfc89fee62d1e59dfacd2ea646d8c3bb41cbef909ec6ed27071512"
+
+
+def test_gh_fetch_url_maps_i686_without_changing_x64_or_arm64():
+    package = get_package("gh")
+
+    assert package.fetch_url("2.97.0", "linux-i686") == URL
+    assert package.fetch_url("2.97.0", "linux-x64") == (
+        "https://github.com/cli/cli/releases/download/v2.97.0/gh_2.97.0_linux_amd64.tar.gz"
+    )
+    assert package.fetch_url("2.97.0", "linux-arm64") == (
+        "https://github.com/cli/cli/releases/download/v2.97.0/gh_2.97.0_linux_arm64.tar.gz"
+    )
+
+
+def test_gh_i686_lock_row_matches_verified_release_asset():
+    lock = Lockfile(paths.lockfile_path())
+
+    assert lock.version("gh") == "2.97.0"
+    assert lock.artifacts("gh", "linux-i686") == [{"url": URL, "sha256": SHA256}]
